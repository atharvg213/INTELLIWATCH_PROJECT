# ==============================================================================
# IntelliWatch Production & Development Environment Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Populate strong secrets before launching in production.
# 3. NEVER commit the active .env file containing credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Mode
# ------------------------------------------------------------------------------
PROJECT_NAME="IntelliWatch"
VERSION="0.1.0"
ENVIRONMENT="production"      # Options: development, staging, production
DEBUG=false                   # Set to false in production to prevent stack trace leakage

# ------------------------------------------------------------------------------
# 2. Server & Network Configuration
# ------------------------------------------------------------------------------
API_HOST="0.0.0.0"
API_PORT=8000

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS)
# Example for production: CORS_ORIGINS="https://intelliwatch.yourdomain.com,http://localhost:8000"
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"

# ------------------------------------------------------------------------------
# 3. Logging & Auditing
# ------------------------------------------------------------------------------
LOG_LEVEL="INFO"              # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE="logs/intelliwatch.log"

# ------------------------------------------------------------------------------
# 4. Authentication, RBAC & Security Credentials
# ------------------------------------------------------------------------------
AUTH_ENABLED=true

# Cryptographically strong secret key used for session hashing (minimum 32 characters)
AUTH_SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"

# Session timeout in minutes
AUTH_TOKEN_EXPIRE_MINUTES=120

# Initial Bootstrap Administrator Credentials (used only on first-time DB creation)
AUTH_DEFAULT_ADMIN_USERNAME="admin"
AUTH_DEFAULT_ADMIN_PASSWORD="REPLACE_WITH_STRONG_PRODUCTION_PASSWORD!"
AUTH_DEFAULT_ADMIN_EMAIL="admin@intelliwatch.local"

# Brute-force Login Rate Limiting
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_LOCKOUT_SECONDS=300

# ------------------------------------------------------------------------------
# 5. Persistent Operational Storage (SQLite WAL Mode)
# ------------------------------------------------------------------------------
AUTH_DB_PATH="data/auth.db"
ALERT_DATABASE_PATH="data/alerts.db"
ALERT_EVIDENCE_DIR="data/output/alerts/evidence"

# ------------------------------------------------------------------------------
# 6. Computer Vision & Hardware Acceleration Settings
# ------------------------------------------------------------------------------
# Hardware device: "cpu" or "cuda" (falls back automatically to CPU if CUDA CC is incompatible)
DETECTION_DEVICE="cpu"
DETECTION_MODEL_PATH="weights/yolo11n.pt"
DETECTION_CONFIDENCE_THRESHOLD=0.25
DETECTION_IOU_THRESHOLD=0.45

# Industrial Domain & Open-Vocabulary Detector (Optional)
INDUSTRIAL_DETECTION_ENABLED=false
INDUSTRIAL_MODEL_PATH="weights/yolov8s-worldv2.pt"
INDUSTRIAL_CONFIDENCE_THRESHOLD=0.15

# PPE Compliance Verification
PPE_ENABLED=true
PPE_MODEL_PATH="weights/yolo11n.pt"
PPE_CONFIDENCE_THRESHOLD=0.25
PPE_ASSOCIATION_IOU_THRESHOLD=0.20

# Tracking (ByteTrack)
TRACKING_ENABLED=true
TRACKER_TYPE="bytetrack"
TRACK_HIGH_THRESH=0.50
TRACK_LOW_THRESH=0.10
TRACK_MATCH_THRESH=0.80
TRACK_BUFFER=30

# Safety Alerting System
ALERTING_ENABLED=true
ALERT_COOLDOWN_SECONDS=30.0
ALERT_CONFIDENCE_THRESHOLD=0.30
ALERT_CRITICAL_IMMEDIATE=true
